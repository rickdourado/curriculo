---
import "../styles/global.css";
import profile from "../../data/profile.json";
import { THEMES } from "../themes";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${baseUrl}/og.jpg`, Astro.site);
const themeIds = THEMES.map((theme) => theme.id);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: [
    "Arquivista Sênior",
    "Desenvolvedor Python & Especialista em Inteligência Artificial",
    "Doutor em Ciência da Informação",
  ],
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rio de Janeiro",
    addressRegion: "RJ",
    addressCountry: "BR",
  },
  url: canonical.href,
  sameAs: profile.links.map((link) => link.url),
};
---

<!doctype html>
<html lang="pt-BR" data-profile="unificado">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${baseUrl}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${baseUrl}/favicon.ico`} sizes="any" />
    <meta name="theme-color" content="#0a1640" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline define:vars={{ themeIds }}>
      // Define o tema e o perfil antes do primeiro paint para evitar flash visual
      let theme = themeIds[0];
      try {
        const saved = localStorage.getItem("theme");
        if (themeIds.includes(saved)) theme = saved;
      } catch {}
      document.documentElement.dataset.theme = theme;

      const validProfiles = ["unificado", "arquivista", "dev"];
      let activeProfile = "unificado";
      try {
        const params = new URLSearchParams(window.location.search);
        const urlProfile = params.get("perfil") || params.get("profile");
        if (urlProfile && validProfiles.includes(urlProfile)) {
          activeProfile = urlProfile;
        }
      } catch {}
      document.documentElement.dataset.profile = activeProfile;
    </script>
  </head>
  <body>
    <slot />
    <script>
      const validProfiles = ["unificado", "arquivista", "dev"] as const;
      type ProfileId = (typeof validProfiles)[number];

      function setProfile(profileId: ProfileId, updateUrl = true) {
        if (!validProfiles.includes(profileId)) return;
        const root = document.documentElement;
        if (root.dataset.profile !== profileId) {
          root.classList.add("profile-switching");
          window.setTimeout(
            () => root.classList.remove("profile-switching"),
            380,
          );
        }
        root.dataset.profile = profileId;

        // Atualiza estado aria-pressed de todos os botões seletores
        document
          .querySelectorAll<HTMLButtonElement>("[data-set-profile]")
          .forEach((btn) => {
            const isCurrent = btn.dataset.setProfile === profileId;
            btn.setAttribute("aria-pressed", String(isCurrent));
            btn.classList.toggle("active", isCurrent);
          });

        if (updateUrl) {
          try {
            const url = new URL(window.location.href);
            if (profileId === "unificado") {
              url.searchParams.delete("perfil");
              url.searchParams.delete("profile");
            } else {
              url.searchParams.set("perfil", profileId);
            }
            window.history.replaceState({}, "", url.toString());
          } catch {}
        }
      }

      // Sincroniza estado inicial dos botões
      const current =
        (document.documentElement.dataset.profile as ProfileId) || "unificado";
      setProfile(current, false);

      // Escuta cliques nos botões de troca de perfil
      document.addEventListener("click", (e) => {
        const target = (
          e.target as HTMLElement | null
        )?.closest<HTMLButtonElement>("[data-set-profile]");
        if (!target) return;
        const nextProfile = target.dataset.setProfile as ProfileId;
        setProfile(nextProfile, true);
      });
    </script>
  </body>
</html>
