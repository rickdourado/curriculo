---
import work from "../../data/work.json";

const profileIds = ["unificado", "arquivista", "dev"] as const;
---

<section class="section" id="work">
  {
    profileIds.map((pid) => (
      <div class="profile-block" data-for-profile={pid}>
        <dl class="stats">
          {work.stats[pid].map((stat) => (
            <div>
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))}
        </dl>
        <h2>{work.sectionTitle[pid]}</h2>
      </div>
    ))
  }

  <div class="case-list">
    {
      work.caseStudies.map((study) => (
        <article
          class="case"
          data-case-profiles={study.profiles.join(" ")}
          style={`--order-unificado: ${study.order.unificado}; --order-arquivista: ${study.order.arquivista}; --order-dev: ${study.order.dev};`}
        >
          <p class="case-meta">
            {study.company} · {study.year}
          </p>
          <h3>{study.title}</h3>
          <div class="case-grid">
            <div>
              <h4>Desafio</h4>
              <p>{study.problem}</p>
            </div>
            <div>
              <h4>Abordagem</h4>
              <p>{study.approach}</p>
            </div>
            <div>
              <h4>Resultado</h4>
              <p>{study.result}</p>
            </div>
          </div>
          <ul class="tags">
            {study.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
