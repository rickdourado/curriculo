---
import profile from "../../data/profile.json";

const nav = [
  { href: "#work", label: "Destaques" },
  { href: "#experience", label: "Experiência" },
  { href: "#skills", label: "Competências" },
  { href: "#projects", label: "Projetos" },
  { href: "#contact", label: "Contato" },
];

const profiles = [
  profile.profiles.unificado,
  profile.profiles.arquivista,
  profile.profiles.dev,
];
---

<header class="topbar">
  <a class="mark" href="#top">
    <span class="full">{profile.shortName}</span>
    <span class="short">{profile.initials}</span>
  </a>

  <div class="topbar-switcher" role="group" aria-label="Alternar perfil profissional">
    {
      profiles.map((p) => (
        <button
          type="button"
          class="topbar-pill"
          data-set-profile={p.id}
          aria-pressed={p.id === "unificado" ? "true" : "false"}
        >
          {p.shortLabel}
        </button>
      ))
    }
  </div>

  <nav aria-label="Navegação principal">
    {nav.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<script>
  const topbar = document.querySelector(".topbar");
  const markScrolled = () => topbar?.classList.toggle("scrolled", window.scrollY > window.innerHeight * 0.25);
  window.addEventListener("scroll", markScrolled, { passive: true });
  markScrolled();
</script>
