---
import projects from "../../data/projects.json";

const profileIds = ["unificado", "arquivista", "dev"] as const;
---

<section class="section" id="projects">
  {
    profileIds.map((pid) => (
      <div class="profile-block" data-for-profile={pid}>
        <h2>{projects.sectionTitle[pid]}</h2>
      </div>
    ))
  }

  <div class="projects">
    {
      projects.items.map((project) => (
        <a class="project" href={project.url} target="_blank" rel="noopener noreferrer">
          <p class="project-category">{project.category}</p>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="tags project-tags">
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>
</section>
