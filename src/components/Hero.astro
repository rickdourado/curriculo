---
import profile from "../../data/profile.json";
import i18n from "../../data/i18n.json";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const names = profile.name.split(" ");
const given = names[0];
const family = names[names.length - 1];
const middle = names.slice(1, -1).join(" ");

const profileKeys = ["unificado", "arquivista", "dev"] as const;

const printContactPt = [
  profile.pt.location,
  profile.phone,
  profile.email,
  "linkedin.com/in/rickribeiro",
  "github.com/rickdourado",
  `${profile.pt.nationality} · ${profile.pt.travelAvailability}`,
];

const printContactEn = [
  profile.en.location,
  profile.phone,
  profile.email,
  "linkedin.com/in/rickribeiro",
  "github.com/rickdourado",
  `${profile.en.nationality} · ${profile.en.travelAvailability}`,
];
---

<section class="hero" id="top">
  <div class="hero-copy">
    <div class="profile-selector" role="group" aria-label="Escolha a lente de leitura do currículo / Choose resume focus">
      <p class="selector-label">
        <span data-for-lang="pt">{i18n.pt.selectorLabel}</span>
        <span data-for-lang="en">{i18n.en.selectorLabel}</span>
      </p>
      <div class="selector-cards">
        {
          profileKeys.map((k) => {
            const pPt = profile.pt.profiles[k];
            const pEn = profile.en.profiles[k];
            return (
              <button
                type="button"
                class={`selector-card selector-${k}`}
                data-set-profile={k}
                aria-pressed={k === "unificado" ? "true" : "false"}
              >
                <span class="selector-title">
                  <span data-for-lang="pt">{pPt.label}</span>
                  <span data-for-lang="en">{pEn.label}</span>
                </span>
                <span class="selector-sub">
                  <span data-for-lang="pt">{pPt.subtitle}</span>
                  <span data-for-lang="en">{pEn.subtitle}</span>
                </span>
              </button>
            );
          })
        }
      </div>
    </div>

    <h1>{given} <em>{middle}</em> {family}</h1>

    {
      profileKeys.map((k) => {
        const pPt = profile.pt.profiles[k];
        const pEn = profile.en.profiles[k];
        return (
          <div class="profile-block" data-for-profile={k}>
            <p class="eyebrow" data-for-lang="pt">
              {pPt.headline.map((part, i) => (
                <Fragment>
                  <span>{i < pPt.headline.length - 1 ? `${part} ·` : part}</span>{" "}
                </Fragment>
              ))}
            </p>
            <p class="eyebrow" data-for-lang="en">
              {pEn.headline.map((part, i) => (
                <Fragment>
                  <span>{i < pEn.headline.length - 1 ? `${part} ·` : part}</span>{" "}
                </Fragment>
              ))}
            </p>
          </div>
        );
      })
    }

    <p class="print-only print-contact" data-for-lang="pt">{printContactPt.join(" · ")}</p>
    <p class="print-only print-contact" data-for-lang="en">{printContactEn.join(" · ")}</p>

    {
      profileKeys.map((k) => {
        const pPt = profile.pt.profiles[k];
        const pEn = profile.en.profiles[k];
        return (
          <div class="profile-block" data-for-profile={k}>
            <div data-for-lang="pt">
              <p class="lede">{pPt.lede}</p>
              <p class="emphasis-banner">
                <span class="emphasis-dot" aria-hidden="true" />
                <span>{pPt.emphasisNote}</span>
              </p>
              <p class="availability">
                <span class="dot" />
                {pPt.availability}
              </p>
              <div class="ctas">
                <a class="btn primary" href={`mailto:${profile.email}`}>{i18n.pt.contactBtn}</a>
                <a class="btn" href={`${baseUrl}/${pPt.pdfFile}`} download={pPt.pdfDownloadName}>
                  {pPt.pdfButtonLabel}
                </a>
                <a class="btn ghost" href="https://www.linkedin.com/in/rickribeiro" target="_blank" rel="noopener noreferrer">
                  LinkedIn
                </a>
                <a class="btn ghost" href="https://github.com/rickdourado" target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              </div>
            </div>

            <div data-for-lang="en">
              <p class="lede">{pEn.lede}</p>
              <p class="emphasis-banner">
                <span class="emphasis-dot" aria-hidden="true" />
                <span>{pEn.emphasisNote}</span>
              </p>
              <p class="availability">
                <span class="dot" />
                {pEn.availability}
              </p>
              <div class="ctas">
                <a class="btn primary" href={`mailto:${profile.email}`}>{i18n.en.contactBtn}</a>
                <a class="btn" href={`${baseUrl}/${pEn.pdfFile}`} download={pEn.pdfDownloadName}>
                  {pEn.pdfButtonLabel}
                </a>
                <a class="btn ghost" href="https://www.linkedin.com/in/rickribeiro" target="_blank" rel="noopener noreferrer">
                  LinkedIn
                </a>
                <a class="btn ghost" href="https://github.com/rickdourado" target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
