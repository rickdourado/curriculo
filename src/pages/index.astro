---
import profile from "../../data/profile.json";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import StarryNight from "../components/StarryNight.astro";
import TopBar from "../components/TopBar.astro";
import Work from "../components/Work.astro";
import Base from "../layouts/Base.astro";

const defaultProfilePt = profile.pt.profiles.unificado;
const defaultProfileEn = profile.en.profiles.unificado;
---

<Base
  titlePt={`${profile.name} · ${defaultProfilePt.roleTitle}`}
  titleEn={`${profile.name} · ${defaultProfileEn.roleTitle}`}
  descriptionPt={defaultProfilePt.description}
  descriptionEn={defaultProfileEn.description}
>
  <a class="skip" href="#main">
    <span data-for-lang="pt">Pular para o conteúdo</span>
    <span data-for-lang="en">Skip to content</span>
  </a>
  <StarryNight />
  <TopBar />
  <main id="main">
    <Hero />
    <Work />
    <Experience />
    <Projects />
    <Contact />
  </main>
</Base>
